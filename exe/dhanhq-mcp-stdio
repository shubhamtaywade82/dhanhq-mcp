#!/usr/bin/env ruby
# frozen_string_literal: true

# Support running from development checkout
lib_path = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib_path) if File.directory?(lib_path) && !$LOAD_PATH.include?(lib_path)

require "dotenv/load"
require "dhan_hq"
require "dhanhq-mcp"

DhanHQ.configure_with_env
DhanHQ.logger.level = (ENV["DHAN_LOG_LEVEL"] || "INFO").upcase.then { |level| Logger.const_get(level) }

client = DhanHQ.respond_to?(:client) ? DhanHQ.client : DhanHQ
policy = Dhanhq::Mcp::Policy.from_env
context = Dhanhq::Mcp::Context.new(client: client, policy: policy)

Dhanhq::Mcp::StdioServer.new(context: context).run
